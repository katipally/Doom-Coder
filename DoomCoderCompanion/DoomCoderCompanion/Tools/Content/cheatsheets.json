[
  {
    "tool": "Claude Code",
    "iconAsset": "agent-claude",
    "summary": "Anthropic's terminal coding agent. Run `claude` in a repo to start an interactive session.",
    "sections": [
      {
        "title": "Start & sessions",
        "entries": [
          { "command": "claude", "detail": "Start an interactive session in the current directory." },
          { "command": "claude -p \"task\"", "detail": "One-shot: run a prompt, print the result, and exit." },
          { "command": "claude -c", "detail": "Continue the most recent conversation in this directory." },
          { "command": "claude -r", "detail": "Resume a previous session (pick from a list)." },
          { "command": "cat file | claude -p \"explain\"", "detail": "Pipe file contents in as context." }
        ]
      },
      {
        "title": "Slash commands",
        "entries": [
          { "command": "/init", "detail": "Scaffold a CLAUDE.md describing your project." },
          { "command": "/clear", "detail": "Reset the conversation and free all context." },
          { "command": "/compact", "detail": "Summarize the session to reclaim context tokens." },
          { "command": "/context", "detail": "Show current context usage and suggestions." },
          { "command": "/model", "detail": "Switch the model for the session (e.g. Opus / Sonnet / Haiku)." },
          { "command": "/agents", "detail": "List and manage sub-agents." },
          { "command": "/help", "detail": "List all available slash commands." }
        ]
      },
      {
        "title": "Useful flags",
        "entries": [
          { "command": "--model <id>", "detail": "Choose the model at launch." },
          { "command": "--permission-mode plan", "detail": "Start in read-only planning mode." },
          { "command": "--dangerously-skip-permissions", "detail": "Skip approval prompts (sandboxes only)." }
        ]
      }
    ]
  },
